# Personal shell overrides seeded once by install.sh (seed_shell_locals).
# The deployed rcs are symlinks into the repo and load these last; because
# they are untracked, `install.sh config` and `rice update` never touch them.
home/.zshrc.local
home/.bashrc.local
home/.zprofile.local
home/.profile.local

# XDG applications rewrite this file. The repository has only a first-install
# seed in seeds/mimeapps.list; the live default choices stay local.
home/.config/mimeapps.list

home/.config/spotify/prefs
home/.config/gh/
**/sessionData/
