# Aroli New Tab: live system theme, derived from the pywal palette on every
# wallpaper change by aroli-newtab-pywal.sh. Seeded from the .example
# fallbacks by install.sh; same state-not-config pattern as hypridle.conf.
home/.config/aroli-newtab/theme-system.css
home/.config/aroli-newtab/theme-system.json

home/.config/systemd/user/*.wants/

home/.config/hypr/hypridle.conf
# Personal overrides: seeded once by install.sh from user.lua.example /
# user.conf.example, then owned by you. Tracked defaults stay in
# hyprland.lua / hyprland.conf; the user files load last and win. Because
# they are untracked, tag checkouts (`rice update`) and `git pull` never
# touch them, and they never dirty the tree, so the update guard stays green.
home/.config/hypr/user.lua
home/.config/hypr/user.conf
# The ACTIVE lock-screen language file. It is seeded by copying over
# language.es.conf or language.en.conf, and those two are versioned.
# Without this line, './install.sh --lang en' wrote inside the repository
# itself - in --link mode, ~/.config/hypr IS the repository - and dirtied Git.
home/.config/hypr/language.conf
# The Settings > Appearance > Effects switch rewrites this file. In --link
# mode it therefore lives inside the repo. Defaults stay versioned in
# hyprland.lua, so nothing is lost if this runtime state file is absent.
home/.config/hypr/effects.lua
# Pre-en-US name, retained only to keep existing installations clean until the
# installer migrates it to effects.lua.
home/.config/hypr/efectos.lua
# The same applies to Qt palettes: qt-pywal.py rewrites them on EVERY
# wallpaper change (its own header says "do not edit manually"). The
# neighboring qt5ct.conf/qt6ct.conf files are versioned: they contain actual
# settings - dialogs and typography - and the script rewrites only the four
# keys required for the palette to apply
# (color_scheme_path, custom_palette, style e icon_theme).
home/.config/qt5ct/colors/
home/.config/qt6ct/colors/
# kdeglobals, on the other hand, IS versioned even though the same script
# rewrites it: besides colors, it contains desktop typography and file-dialog
# settings, which are part of the rice. In --link mode it will appear modified
# after each wallpaper change; the repository version seeds a new installation.
home/.config/poke-theme/state
home/.config/spicetify/config-xpui.ini

home/.config/vlc/vlc-qt-interface.conf

