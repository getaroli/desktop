#!/usr/bin/env bash
# aroli, version, update and cleanup dispatcher for Aroli Desktop.
#
#   aroli version              print the installed version
#   aroli status               version + update check state + backups
#   aroli check [--force]      ask GitHub for the newest stable tag (cached 24 h)
#   aroli update [--dry-run]   move this checkout to the newest stable tag
#   aroli rollback             go back to the ref recorded before the last update
#   aroli prune [--apply]      list (or trash) files orphaned by the last update
#
# Design rules, all learned from install.sh and pacman-updates.sh:
# - `check` is the ONLY network command that runs unattended (systemd timer).
#   It transfers a few KB (ls-remote or one API GET with ETag) and writes a
#   single cache file. Everything else is on-demand and asks first.
# - `update` only follows stable tags (vX.Y.Z). `main` is never auto-applied.
# - Nothing is deleted. `prune --apply` moves orphans to the trash (or to
#   ~/.dotfiles-backup when no trash exists) and `rollback` brings them back.
# - State files the desktop rewrites at runtime (hypridle.conf, language.conf,
#   effects.lua, qt palettes, poke-theme/state) are never prune candidates.

set -uo pipefail

VERSION_FILE_CANDIDATES=()
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/aroli-desktop"
CACHE_FILE="$CACHE_DIR/update.json"
ETAG_FILE="$CACHE_DIR/latest.etag"
LOCK_FILE="$CACHE_DIR/aroli.lock"
STATE_FILE="$CACHE_DIR/state.json"
CHECK_INTERVAL=86400   # 24 h: releases ship a few times per month, not per hour
NET_TIMEOUT=20
REPO_SLUG="getaroli/desktop"

DRY=0
ASSUME_YES=0
QUIET=0
FORCE=0
APPLY=0
NO_REINSTALL=0
CHANNEL="stable"
CHANNEL_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/aroli/channel"

if [ -t 1 ] && [ "${NO_COLOR:-}" = "" ]; then
    C_TIT=$'\033[1;34m'; C_OK=$'\033[32m'; C_WARN=$'\033[33m'
    C_BAD=$'\033[31m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
else
    C_TIT=; C_OK=; C_WARN=; C_BAD=; C_DIM=; C_OFF=
fi

say()  { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }
ok()   { [ "$QUIET" = 1 ] || printf '  %sok%s   %s\n' "$C_OK" "$C_OFF" "$*"; }
skip() { [ "$QUIET" = 1 ] || printf '  %s--%s   %s%s%s\n' "$C_DIM" "$C_OFF" "$C_DIM" "$*" "$C_OFF"; }
warn() { printf '  %swarn%s %s\n' "$C_WARN" "$C_OFF" "$*" >&2; }
err()  { printf '  %sERROR%s %s\n' "$C_BAD" "$C_OFF" "$*" >&2; }
die()  { err "$*"; exit 1; }

ask() {
    [ "$ASSUME_YES" = 1 ] && return 0
    [ "$DRY" = 1 ] && return 1
    [ -t 0 ] || return 1
    local answer
    read -r -p "  $1 [y/N] " answer
    [[ "$answer" =~ ^[sSyY]$ ]]
}

# ------------------------------------------------------------------ repo

# Where the aroli checkout lives. Resolution order: explicit env, the symlink
# install.sh lays down (~/.config/quickshell -> <repo>/home/.config/quickshell),
# common clone locations, finally the script's own directory (running in-repo).
find_repo() {
    if [ -n "${AROLI_DESKTOP_REPO:-}" ] && [ -d "${AROLI_DESKTOP_REPO:-}/.git" ]; then
        printf '%s' "$AROLI_DESKTOP_REPO"
        return 0
    fi
    # Compatibility with checkouts from before the Umbra Noctis -> Aroli
    # Desktop rename.
    if [ -n "${UMBRA_RICE_REPO:-}" ] && [ -d "${UMBRA_RICE_REPO:-}/.git" ]; then
        printf '%s' "$UMBRA_RICE_REPO"
        return 0
    fi
    local link
    if [ -L "$HOME/.config/quickshell" ]; then
        link="$(readlink -f "$HOME/.config/quickshell" 2>/dev/null)"
        case "$link" in
            */home/.config/quickshell)
                printf '%s' "${link%/home/.config/quickshell}"
                return 0 ;;
        esac
    fi
    local cand
    for cand in "$HOME/aroli-desktop" "$HOME/aroli/desktop" "$HOME/umbra-noctis" "$HOME/dotfiles" "$HOME/.dotfiles"; do
        if [ -d "$cand/.git" ]; then printf '%s' "$cand"; return 0; fi
    done
    local here
    here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    if [ -d "$here/../../.git" ]; then
        (cd "$here/../.." && pwd)
        return 0
    fi
    return 1
}

REPO=""
REPO="$(find_repo 2>/dev/null)" || REPO=""

local_version() {
    if [ -n "$REPO" ] && [ -f "$REPO/VERSION" ]; then
        tr -d ' \t\r\n' < "$REPO/VERSION"
    else
        printf '0.0.0-unknown'
    fi
}

# SemVer compare: returns 0 when $1 > $2. Handles optional leading 'v' and
# ignores pre-release suffixes for the comparison (a plain tag always wins).
ver_gt() {
    local a="${1#v}" b="${2#v}"
    a="${a%%-*}"; b="${b%%-*}"
    [ "$a" = "$b" ] && return 1
    local first
    first="$(printf '%s\n%s\n' "$a" "$b" | sort -V | head -1)"
    [ "$first" = "$b" ]
}

highest_tag() {
    # Highest vX.Y.Z (no suffix) from a newline-separated tag list on stdin.
    grep -E '^v?[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1
}

# ------------------------------------------------------------------ cache

read_cache_field() {  # $1 = field name; prints "" when missing/unreadable
    local f="$1"
    [ -f "$CACHE_FILE" ] || return 0
    if command -v jq >/dev/null 2>&1; then
        jq -r --arg f "$f" '.[$f] // ""' "$CACHE_FILE" 2>/dev/null
    else
        sed -n "s/^[[:space:]]*\"$f\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$CACHE_FILE" | head -1
    fi
}

write_cache() {  # $1=remote $2=available(true/false) $3=took_ms $4=source
    mkdir -p "$CACHE_DIR"
    local tmp now
    tmp="$(mktemp "${TMPDIR:-/tmp}/aroli-cache.XXXXXXXX")"
    now="$(date +%s)"
    printf '{\n  "local": "%s",\n  "remote": "%s",\n  "update_available": %s,\n  "checked_at": %s,\n  "took_ms": %s,\n  "source": "%s"\n}\n' \
        "$(local_version)" "$1" "$2" "$now" "$3" "$4" > "$tmp"
    mv -f "$tmp" "$CACHE_FILE"
}

record_state() {  # $1=previous_ref $2=new_ref
    mkdir -p "$CACHE_DIR"
    local tmp
    tmp="$(mktemp "${TMPDIR:-/tmp}/aroli-state.XXXXXXXX")"
    printf '{\n  "previous_ref": "%s",\n  "current_ref": "%s",\n  "updated_at": %s\n}\n' \
        "$1" "$2" "$(date +%s)" > "$tmp"
    mv -f "$tmp" "$STATE_FILE"
}

# update.json remains the update-check cache, with a small progress object so
# an interrupted delivery is visible without inventing a second state file.
record_update_progress() {  # $1=phase $2=status $3=before $4=after
    mkdir -p "$CACHE_DIR"
    local tmp remote avail
    tmp="$(mktemp "${TMPDIR:-/tmp}/aroli-progress.XXXXXXXX")"
    remote="$(read_cache_field remote)"; avail="$(read_cache_field update_available)"
    printf '{\n  "local": "%s",\n  "remote": "%s",\n  "update_available": %s,\n  "progress": {"phase": "%s", "status": "%s", "before": "%s", "after": "%s", "updated_at": %s}\n}\n' \
        "$(local_version)" "$remote" "${avail:-false}" "$1" "$2" "$3" "$4" "$(date +%s)" > "$tmp"
    mv -f "$tmp" "$CACHE_FILE"
}

aroli_cli() {
    local cli="$HOME/.local/bin/aroli"
    [ -x "$cli" ] || { err "the Aroli CLI is missing at $cli"; return 1; }
    "$cli" "$@"
}

deliver_update() {  # $1=before $2=after
    local before="$1" after="$2" stamp
    stamp="$(date +%Y%m%d-%H%M%S)"
    record_update_progress snapshot-pre running "$before" "$after"
    aroli_cli snapshot create "update-pre-$stamp" || { record_update_progress snapshot-pre failed "$before" "$after"; return 1; }
    record_update_progress materialize running "$before" "$after"
    aroli_cli materialize --repo "$REPO" || { record_update_progress materialize failed "$before" "$after"; return 1; }
    record_update_progress doctor running "$before" "$after"
    aroli_cli doctor || { record_update_progress doctor failed "$before" "$after"; return 1; }
    record_update_progress snapshot-post running "$before" "$after"
    aroli_cli snapshot create "update-post-$stamp" || { record_update_progress snapshot-post failed "$before" "$after"; return 1; }
    record_update_progress complete ok "$before" "$after"
}

# Notify at most once per remote tag. Both the daily check and the login
# notifier funnel here, so a pending update nags once per release, never
# once per day. The seen mark is only written when notify-send reports
# success: with no notification daemon running, the next login retries
# instead of swallowing the notice.
SEEN_FILE="$CACHE_DIR/update-notify.seen"
notify_update_available() {  # $1 = remote tag
    [ "$(cat "$SEEN_FILE" 2>/dev/null)" = "$1" ] && return 1
    command -v notify-send >/dev/null 2>&1 || return 1
    if notify-send "Aroli Desktop $1 available" "Run: aroli update --dry-run" 2>/dev/null; then
        printf '%s' "$1" > "$SEEN_FILE" 2>/dev/null || true
        return 0
    fi
    return 1
}

# ------------------------------------------------------------------ check

remote_via_git() {
    [ -n "$REPO" ] || return 1
    git -C "$REPO" ls-remote --tags origin 2>/dev/null \
        | awk '{print $2}' | sed 's#^refs/tags/##; s#\^{}$##' | highest_tag
}

# The real fetch, plainly: headers to one file, body to another.
remote_via_api() {
    local hdr body code tag etag
    hdr="$(mktemp "${TMPDIR:-/tmp}/aroli-hdr.XXXXXXXX")"
    body="$(mktemp "${TMPDIR:-/tmp}/aroli-body.XXXXXXXX")"
    trap 'rm -f "$hdr" "$body"' RETURN
    if [ -f "$ETAG_FILE" ]; then
        code="$(curl -sS -m "$NET_TIMEOUT" -o "$body" -D "$hdr" -w '%{http_code}' \
            -H "Accept: application/vnd.github+json" \
            -H "If-None-Match: $(cat "$ETAG_FILE")" \
            "https://api.github.com/repos/$REPO_SLUG/releases/latest" 2>/dev/null)"
    else
        code="$(curl -sS -m "$NET_TIMEOUT" -o "$body" -D "$hdr" -w '%{http_code}' \
            -H "Accept: application/vnd.github+json" \
            "https://api.github.com/repos/$REPO_SLUG/releases/latest" 2>/dev/null)"
    fi
    case "$code" in
        304) read_cache_field remote; return 0 ;;
        200)
            etag="$(grep -i '^etag:' "$hdr" | tr -d '\r' | sed 's/^[Ee][Tt][Aa][Gg]: *//' | head -1)"
            [ -n "$etag" ] && printf '%s' "$etag" > "$ETAG_FILE"
            if command -v jq >/dev/null 2>&1; then
                tag="$(jq -r '.tag_name // ""' "$body" 2>/dev/null)"
            else
                tag="$(sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$body" | head -1)"
            fi
            [ -n "$tag" ] && printf '%s' "$tag"
            return 0 ;;
        *) return 1 ;;
    esac
}

cmd_check() {
    mkdir -p "$CACHE_DIR"
    exec 9> "$LOCK_FILE"
    if ! flock -n 9; then
        skip "another aroli check is already running"
        exit 0
    fi

    local last=0 now remote="" source="throttled" start_ms end_ms took
    now="$(date +%s)"
    if [ -f "$CACHE_FILE" ]; then
        last="$(read_cache_field checked_at)"
        [[ "$last" =~ ^[0-9]+$ ]] || last=0
    fi
    if [ "$FORCE" = 0 ] && [ "$last" -gt 0 ] && [ $((now - last)) -lt "$CHECK_INTERVAL" ]; then
        say "aroli: cache is fresh ($(read_cache_field remote)); use --force to re-check"
        exit 0
    fi

    start_ms="$(date +%s%3N 2>/dev/null || echo $((now * 1000)))"
    if remote="$(remote_via_git)" && [ -n "$remote" ]; then
        source="git-ls-remote"
    elif remote="$(remote_via_api)" && [ -n "$remote" ]; then
        source="github-api"
    else
        warn "could not reach the update source; keeping the previous answer"
        [ -f "$CACHE_FILE" ] || write_cache "$(local_version)" false 0 "none"
        exit 0
    fi
    end_ms="$(date +%s%3N 2>/dev/null || echo $(($(date +%s) * 1000)))"
    took=$((end_ms - start_ms))
    local avail=false
    ver_gt "$remote" "$(local_version)" && avail=true
    write_cache "$remote" "$avail" "$took" "$source"
    if [ "$avail" = true ]; then
        say "aroli: update available: $(local_version) -> $remote"
        notify_update_available "$remote" || true
    else
        ok "aroli is up to date ($(local_version))"
    fi
}

# Login notifier: cache-read only, zero network, exits in milliseconds.
# The daily timer owns the network check; this only surfaces an already
# known pending update as a desktop notice after graphical login. Never
# fails: every guard exits 0 silently, so a broken cache or a missing
# daemon can neither spam nor break the login.
cmd_notify_login() {
    [ "${RICE_NO_UPDATE_NOTIFY:-0}" = 1 ] && exit 0
    local remote avail
    remote="$(read_cache_field remote)"
    avail="$(read_cache_field update_available)"
    [ "$avail" = true ] && [ -n "$remote" ] || exit 0
    # The cache may predate an update applied by hand: only nag while the
    # checkout is actually behind the known tag.
    ver_gt "$remote" "$(local_version)" || exit 0
    notify_update_available "$remote" || true
    exit 0
}

# ------------------------------------------------------------------ update

current_ref() {
    if [ -n "$REPO" ]; then
        git -C "$REPO" describe --tags --exact-match 2>/dev/null \
            || git -C "$REPO" rev-parse --short HEAD 2>/dev/null \
            || printf '%s' "$(local_version)"
    else
        printf '%s' "$(local_version)"
    fi
}

# Files the desktop itself rewrites wholesale and regenerates on demand:
# qt-pywal.py rebuilds kdeglobals on every wallpaper change, and Spotify
# theming rebuilds the spicetify color.ini on apply. In --link mode these
# live inside the checkout, so normal desktop use dirties the tree through
# no fault of the user. Resetting them is safe: the next wallpaper change
# or theme apply recreates the live values.
RUNTIME_REGENERATED="home/.config/kdeglobals
home/.config/spicetify/Themes/termspot/color.ini"

# A dirty checkout must never strand a non-technical user: ride local
# changes out in a stash and bring them back after the checkout moves.
STASHED=0
stash_live_changes() {  # $1 = ref being moved to, for messages
    STASHED=0
    local f reset_any=0
    for f in $RUNTIME_REGENERATED; do
        if [ -n "$(git -C "$REPO" status --porcelain -- "$f" 2>/dev/null)" ]; then
            git -C "$REPO" checkout -- "$f" 2>/dev/null && reset_any=1 || true
        fi
    done
    [ "$reset_any" = 1 ] && say "runtime-regenerated files reset (they rebuild on the next wallpaper/theme change)"
    [ -n "$(git -C "$REPO" status --porcelain 2>/dev/null)" ] || return 0
    # -u covers untracked files that would otherwise block the checkout; -c
    # identity keeps stash working before the user ever sets up git
    # (install.sh only seeds a placeholder identity).
    if git -C "$REPO" -c user.name="Aroli Desktop" -c user.email="aroli@localhost" stash push -u -m "aroli auto-stash before $1" >/dev/null 2>&1; then
        STASHED=1
        say "remaining local changes stashed; they are restored after the checkout"
    else
        err "the checkout has local changes and they could not be stashed."
        err "look with: git -C \"$REPO\" status --short"
        return 1
    fi
}
restore_live_changes() {  # $1 = ref now checked out, for messages
    [ "$STASHED" = 1 ] || return 0
    STASHED=0
    if git -C "$REPO" -c user.name="Aroli Desktop" -c user.email="aroli@localhost" stash pop >/dev/null 2>&1; then
        ok "local changes restored"
    else
        warn "now on $1, but some previous changes did not re-apply cleanly."
        warn "they are kept in the stash, nothing was deleted:"
        warn "  git -C \"$REPO\" stash list"
    fi
}

# Hands the update over to the target tag's own backend (see cmd_update).
# Returns 0 when there is nothing to hand over to (already that backend);
# 1 when the hop is impossible (offline: fetch failed), the caller then
# falls back to this checkout's updater, i.e. today's behavior;
# 2 when the tag has no usable backend, the caller must refuse, not check
# out a release whose updater is missing.
bootstrap_update_backend() {  # $1 = remote tag
    local tag="$1" tmp args=()
    git -C "$REPO" fetch --tags origin >/dev/null 2>&1 || return 1
    tmp="$(mktemp "${TMPDIR:-/tmp}/aroli-backend.XXXXXXXX")" || return 1
    if ! git -C "$REPO" show "$tag:home/.local/bin/aroli-backend" > "$tmp" 2>/dev/null \
        || [ ! -s "$tmp" ] || ! bash -n "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        err "tag $tag has no usable updater; not checking it out"
        return 2
    fi
    if [ -n "${BASH_SOURCE[0]:-}" ] && cmp -s "${BASH_SOURCE[0]}" "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        return 0
    fi
    chmod +x "$tmp" 2>/dev/null || true
    # Faithful flag forwarding, never consent escalation: the new backend
    # asks its own confirmation unless the user already passed --yes.
    [ "$ASSUME_YES" = 1 ] && args+=(--yes)
    [ "$QUIET" = 1 ] && args+=(--quiet)
    [ "$FORCE" = 1 ] && args+=(--force)
    [ "$NO_REINSTALL" = 0 ] || args+=(--no-reinstall)
    [ "$CHANNEL" = stable ] || args+=(--channel="$CHANNEL")
    say "handing over to $tag's own updater"
    RICE_BACKEND_BOOTSTRAPPED=1 exec bash "$tmp" update "${args[@]}"
    rm -f "$tmp"
    return 1
}

cmd_update() {
    [ -n "$REPO" ] || die "could not find the aroli checkout (set AROLI_DESKTOP_REPO)"
    [ "$CHANNEL" = stable ] || [ "$CHANNEL" = unstable-dev ] || die "channel must be stable or unstable-dev"
    command -v git >/dev/null || die "git is missing"

    # Development follows the named integration branch only. It never follows
    # main, and stable remains tag-only, so a release is the sole promotion.
    if [ "$CHANNEL" = unstable-dev ]; then
        local before
        before="$(current_ref)"
        if [ "$DRY" = 1 ]; then
            say "would: git fetch origin unstable-dev && git checkout -B unstable-dev origin/unstable-dev"
            return 0
        fi
        ask "update this box from origin/unstable-dev?" || { skip "cancelled; nothing changed"; return 0; }
        stash_live_changes "unstable-dev" || return 1
        git -C "$REPO" fetch origin unstable-dev || { restore_live_changes "$before"; die "git fetch failed"; }
        git -C "$REPO" checkout -B unstable-dev origin/unstable-dev || { restore_live_changes "$before"; die "git checkout unstable-dev failed"; }
        record_state "$before" "unstable-dev"
        [ "$NO_REINSTALL" = 1 ] || deliver_update "$before" "unstable-dev" || warn "delivery did not complete; see $CACHE_FILE"
        restore_live_changes "unstable-dev"
        return 0
    fi

    local before remote
    before="$(current_ref)"
    FORCE=1 QUIET=1 cmd_check
    remote="$(read_cache_field remote)"
    [ -n "$remote" ] || die "no remote tag known; check the network and run: aroli check --force"

    if ! ver_gt "$remote" "$(local_version)"; then
        # The checkout may sit on an older commit while VERSION already matches
        # (e.g. dirty tree); compare tags too before declaring victory.
        if [ "$before" = "$remote" ]; then
            ok "already on $remote"
            return 0
        fi
    fi

    say "aroli update: $before -> $remote"
    if [ "$DRY" = 1 ]; then
        git -C "$REPO" fetch --tags --dry-run origin 2>&1 | head -5 || true
        say "would: hand over to $remote's own updater, then:"
        say "would: git fetch origin tag $remote && git checkout $remote"
        say "would: record rollback ref ($before) and re-run ./install.sh"
        git -C "$REPO" log --oneline "$before..$remote" 2>/dev/null | head -20 || \
            say "(commit list unavailable until fetch)"
        exit 0
    fi

    # Personal tweaks belong in the gitignored overrides
    # (~/.config/hypr/user.lua / user.conf, seeded once by install.sh), which
    # never show up here. Anything else the desktop dirtied on its own is
    # stashed and restored below, so the update never refuses over it.
    ask "fetch and check out $remote, then re-run ./install.sh?" || {
        skip "cancelled; nothing changed"
        exit 0
    }

    # Self-bootstrap: the updater itself is versioned, so this checkout's
    # backend may predate the fixes the update needs. The target tag's
    # backend runs the rest instead, extracted straight from git, without
    # touching the worktree, so dirty trees are safe. RICE_BACKEND_BOOTSTRAPPED
    # guards the hop against looping.
    if [ "${RICE_BACKEND_BOOTSTRAPPED:-0}" != 1 ]; then
        bootstrap_update_backend "$remote"
        case "$?" in
            0) ;;            # already that backend, or hop done (never returns)
            2) exit 1 ;;     # corrupt tag: message already printed
            *) warn "continuing with this checkout's updater instead" ;;
        esac
    fi

    stash_live_changes "$remote" || exit 1

    git -C "$REPO" fetch --tags origin || { restore_live_changes "$remote"; die "git fetch failed"; }
    git -C "$REPO" checkout "$remote" || { restore_live_changes "$remote"; die "git checkout $remote failed"; }
    record_state "$before" "$remote"
    ok "now on $remote (previous: $before; rollback with: aroli rollback)"

    if [ "$NO_REINSTALL" = 0 ]; then
        deliver_update "$before" "$remote" || warn "delivery did not complete; your checkout is still on $remote (see $CACHE_FILE)"
    fi
    restore_live_changes "$remote"
    say "tip: aroli prune lists files the new release retired (nothing is deleted without --apply)"
}

cmd_rollback() {
    [ -n "$REPO" ] || die "could not find the aroli checkout (set AROLI_DESKTOP_REPO)"
    local prev=""
    [ -f "$STATE_FILE" ] && prev="$(read_cache_field previous_ref 2>/dev/null || true)"
    if command -v jq >/dev/null 2>&1 && [ -f "$STATE_FILE" ]; then
        prev="$(jq -r '.previous_ref // ""' "$STATE_FILE" 2>/dev/null)"
    elif [ -f "$STATE_FILE" ]; then
        prev="$(sed -n 's/.*"previous_ref"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$STATE_FILE" | head -1)"
    fi
    [ -n "$prev" ] || die "no previous ref recorded (no update has run yet)"
    say "aroli rollback: $(current_ref) -> $prev"
    if [ "$DRY" = 1 ]; then
        say "would: git checkout $prev && re-run ./install.sh"
        exit 0
    fi
    ask "go back to $prev and re-run ./install.sh?" || { skip "cancelled"; exit 0; }
    stash_live_changes "$prev" || exit 1
    git -C "$REPO" checkout "$prev" || { restore_live_changes "$prev"; die "git checkout $prev failed"; }
    ok "now on $prev"
    if [ "$NO_REINSTALL" = 0 ] && [ -x "$REPO/install.sh" ]; then
        if [ "$ASSUME_YES" = 1 ]; then
            "$REPO/install.sh" --yes || warn "./install.sh reported an error"
        else
            "$REPO/install.sh" || warn "./install.sh reported an error"
        fi
    fi
    restore_live_changes "$prev"
}

# ------------------------------------------------------------------ prune

# Files the desktop rewrites while you use it: state, not config. Never trash.
# effects.lua is the en-US name; efectos.lua is its pre-rename legacy twin,
# still honored by hyprland.lua as a fallback, so it is protected too.
# user.lua / user.conf are yours (gitignored overrides seeded once by
# install.sh): they are never tracked, so they can never be diff-filter=D
# candidates, listed here anyway so no future refactor can trash them.
is_protected() {
    case "$1" in
        home/.config/hypr/hypridle.conf|home/.config/hypr/language.conf|\
        home/.config/hypr/effects.lua|home/.config/hypr/efectos.lua|\
        home/.config/hypr/user.lua|home/.config/hypr/user.conf|\
        home/.config/qt5ct/colors/*|\
        home/.config/qt6ct/colors/*|home/.config/poke-theme/state|\
        home/.config/spicetify/config-xpui.ini|home/.config/vlc/vlc-qt-interface.conf)
            return 0 ;;
    esac
    return 1
}

# Map a repo-relative path to its deployed location. Returns 1 when the path
# is not something install.sh deploys (docs, CI, the repo itself).
deployed_path() {
    case "$1" in
        home/*) printf '%s/%s' "$HOME" "${1#home/}" ;;
        *) return 1 ;;
    esac
}

cmd_prune() {
    [ -n "$REPO" ] || die "could not find the aroli checkout (set AROLI_DESKTOP_REPO)"
    local old new
    if command -v jq >/dev/null 2>&1 && [ -f "$STATE_FILE" ]; then
        old="$(jq -r '.previous_ref // ""' "$STATE_FILE" 2>/dev/null)"
        new="$(jq -r '.current_ref // ""' "$STATE_FILE" 2>/dev/null)"
    else
        old=""; new=""
    fi
    [ -n "$old" ] && [ -n "$new" ] || die "no update recorded yet; prune compares the refs of the last update"

    local removed orphans=0
    # --no-renames on purpose: with rename detection a renamed file shows up
    # as R and --diff-filter=D would miss it, leaving the deployed old path
    # behind forever. As D+A the old path is listed and trashed like any
    # other retiree (the en-US rename release is exactly this case).
    removed="$(git -C "$REPO" diff --no-renames --name-only --diff-filter=D "$old" "$new" 2>/dev/null)" \
        || die "could not diff $old..$new"
    [ -n "$removed" ] || { ok "no files retired between $old and $new"; return 0; }

    local trash="$HOME/.local/share/Trash/files"
    command -v gio >/dev/null 2>&1 && trash="(gio trash)"
    local backup="$HOME/.dotfiles-backup/prune-$(date +%Y%m%d-%H%M%S)"
    local f dest
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        is_protected "$f" && { skip "protected (runtime state): $f"; continue; }
        deployed_path "$f" || { skip "not deployed (repo-only): $f"; continue; }
        dest="$(deployed_path "$f")"
        [ -e "$dest" ] || [ -L "$dest" ] || continue
        # Only trash what the old release left behind: a symlink into the repo
        # (now dangling) or a copy byte-identical to the old blob. Anything the
        # user created or modified is listed but never touched.
        local old_blob target
        old_blob="$(mktemp "${TMPDIR:-/tmp}/aroli-old.XXXXXXXX")"
        if git -C "$REPO" show "$old:$f" > "$old_blob" 2>/dev/null; then
            if [ -L "$dest" ]; then
                # Raw readlink, and not -f, on purpose: a renamed file leaves
                # a DANGLING symlink behind, and `readlink -f` fails on those
                # (empty target), which used to misreport every orphaned link
                # as "modified by you, kept". A link into the repo is ours,
                # dangling or not; a link anywhere else is yours.
                target="$(readlink "$dest" 2>/dev/null)"
                case "$target" in
                    "$REPO"/*) ;;
                    /*) skip "modified by you, kept: $dest"; rm -f "$old_blob"; continue ;;
                    *)
                        resolved="$(cd "$(dirname "$dest")" 2>/dev/null && readlink -f "$target" 2>/dev/null || printf '%s/%s' "$(dirname "$dest")" "$target")"
                        case "$resolved" in "$REPO"/*) ;; *) skip "modified by you, kept: $dest"; rm -f "$old_blob"; continue ;; esac ;;
                esac
            elif ! cmp -s "$old_blob" "$dest" 2>/dev/null; then
                skip "modified by you, kept: $dest"
                rm -f "$old_blob"
                continue
            fi
        else
            skip "cannot verify origin, kept: $dest"
            rm -f "$old_blob"
            continue
        fi
        rm -f "$old_blob"
        orphans=$((orphans + 1))
        if [ "$APPLY" = 0 ] || [ "$DRY" = 1 ]; then
            say "orphan: $dest"
        else
            if [ "$DRY" = 0 ]; then
                mkdir -p "$backup"
                if command -v gio >/dev/null 2>&1; then
                    # Copy first: if the trash move fails (e.g. across
                    # filesystems), the backup is still there and the file
                    # stays put instead of being reported as moved.
                    cp -a "$dest" "$backup/" 2>/dev/null || true
                    if gio trash "$dest" 2>/dev/null; then
                        ok "trashed (+ backup): $dest"
                    else
                        mv -f "$dest" "$backup/" && ok "moved to $backup: $dest"
                    fi
                else
                    mv "$dest" "$backup/" && ok "moved to $backup: $dest"
                fi
            fi
        fi
    done <<<"$removed"

    if [ "$orphans" -eq 0 ]; then
        ok "no orphaned files on disk"
    elif [ "$APPLY" = 0 ] || [ "$DRY" = 1 ]; then
        say "$orphans orphan(s). Nothing was moved. Run: aroli prune --apply"
    else
        say "$orphans orphan(s) moved. Undo with: aroli rollback (or restore from $backup)"
    fi
}

# ------------------------------------------------------------------ misc

cmd_version() { printf '%s\n' "$(local_version)"; }

cmd_status() {
    local remote avail checked
    remote="$(read_cache_field remote)"
    avail="$(read_cache_field update_available)"
    checked="$(read_cache_field checked_at)"
    printf 'aroli      %s\n' "$(local_version)"
    printf 'checkout  %s\n' "$(current_ref)"
    printf 'repo      %s\n' "${REPO:-not found}"
    [ -f "$CHANNEL_FILE" ] && CHANNEL="$(tr -d '[:space:]' < "$CHANNEL_FILE")"
    printf 'channel   %s\n' "$CHANNEL"
    if [ -n "$remote" ]; then
        printf 'latest    %s\n' "$remote"
        [ "$avail" = true ] && printf 'update    available (aroli update --dry-run)\n' \
            || printf 'update    none\n'
    else
        printf 'latest    unknown (aroli check --force)\n'
    fi
    if [[ "$checked" =~ ^[0-9]+$ ]] && [ "$checked" -gt 0 ]; then
        printf 'checked   %s\n' "$(date --date="@$checked" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "$checked")"
    fi
    local prev=""
    [ -f "$STATE_FILE" ] && prev="$(sed -n 's/.*"previous_ref"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$STATE_FILE" | head -1)"
    [ -n "$prev" ] && printf 'rollback  %s\n' "$prev"
}

# Read-only comparison between the release package contract and this box.
cmd_verify() {
    [ -n "$REPO" ] || die "could not find the aroli checkout (set AROLI_DESKTOP_REPO)"
    local manifest="$REPO/manifest.json"
    [ -f "$manifest" ] || die "manifest.json is missing; use a release checkout"
    command -v python3 >/dev/null || die "python3 is required to read manifest.json"
    command -v pacman >/dev/null || die "pacman is required to verify this Arch box"
    local missing=0 pkg
    while IFS= read -r pkg; do
        [ -n "$pkg" ] || continue
        if pacman -Qq "$pkg" >/dev/null 2>&1; then
            printf 'ok       %s\n' "$pkg"
        else
            printf 'missing  %s\n' "$pkg"
            missing=$((missing + 1))
        fi
    done < <(python3 - "$manifest" <<'PY'
import json, sys
for group in ("pacman", "extra", "aur", "gpu"):
    for package in json.load(open(sys.argv[1]))["packages"].get(group, []): print(package)
PY
)
    [ "$missing" -eq 0 ] && { ok "box matches manifest"; return 0; }
    err "$missing package(s) missing; run: aroli install packages"
    return 1
}

usage() {
    cat <<'USAGE'
Usage: aroli <command> [options]

Commands:
  version             print the installed version
  status              version, checkout, last check, rollback ref
  check [--force]     ask GitHub for the newest stable tag (cached 24 h)
  notify-login        desktop notice for a known pending update (login hook)
  update [--dry-run]  check out the newest stable tag and re-run install.sh
  rollback            return to the ref before the last update
  prune [--apply]     list (default) or trash files retired by the last update
  verify              compare installed packages with manifest.json (read-only)

Options:
  -n, --dry-run     show what would happen, change nothing
  -y, --yes         never ask (still never touches user-modified files)
  -q, --quiet       only essential output (for timers)
  --force           ignore the 24 h check cache
  --apply           actually move orphans (prune only)
  --no-reinstall    skip ./install.sh after checkout
  --channel=stable  the only channel (main is never auto-applied)
  -h, --help        this

Examples:
  aroli status
  aroli check --force
  aroli update --dry-run
  aroli prune
  aroli prune --apply
USAGE
}

# ------------------------------------------------------------------ main

CMD=""
while [ $# -gt 0 ]; do
    case "$1" in
        -n|--dry-run) DRY=1 ;;
        -y|--yes) ASSUME_YES=1 ;;
        -q|--quiet) QUIET=1 ;;
        --force) FORCE=1 ;;
        --apply) APPLY=1 ;;
        --no-reinstall) NO_REINSTALL=1 ;;
        --channel=*) CHANNEL="${1#*=}" ;;
        --channel) shift; CHANNEL="${1:-}"; [ -n "$CHANNEL" ] || die "--channel needs a value" ;;
        -h|--help|help) usage; exit 0 ;;
        version|status|check|notify-login|update|rollback|prune|verify) CMD="$1" ;;
        *) die "unknown argument: $1 (try: aroli --help)" ;;
    esac
    shift
done
[ -n "$CMD" ] || { usage; exit 1; }

case "$CMD" in
    version)  cmd_version ;;
    status)   cmd_status ;;
    check)    cmd_check ;;
    notify-login) cmd_notify_login ;;
    update)   cmd_update ;;
    rollback) cmd_rollback ;;
    prune)    cmd_prune ;;
    verify)   cmd_verify ;;
esac
