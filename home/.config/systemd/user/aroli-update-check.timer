[Unit]
# Once a day is plenty: beta releases ship a few times per month, not per hour.
# AccuracySec + RandomizedDelaySec let systemd coalesce this with other daily
# timers instead of waking the machine for it alone.
Description=Aroli Desktop update check, daily

[Timer]
OnBootSec=15min
OnUnitInactiveSec=24h
AccuracySec=1h
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
