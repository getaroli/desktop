[Unit]
# Aroli Desktop login notice: surfaces a KNOWN pending update on login.
#
# This performs zero network: it only reads ~/.cache/aroli-desktop/update.json
# (written by aroli-update-check.timer) and exits in milliseconds. At most one
# notice per release (tracked in update-notify.seen); with no pending update,
# or with no notification daemon running, it exits silently.
#
# Opt out (stays off, check cache and bar dot keep working):
#   systemctl --user disable aroli-update-notify.service
Description=Aroli Desktop update notice on graphical login (cache read only)
Documentation=file://%h/.local/bin/aroli
PartOf=graphical-session.target
After=graphical-session.target quickshell.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=oneshot
ExecStart=%h/.local/bin/aroli notify-login
LockPersonality=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
MemoryMax=50M
CPUQuota=20%

[Install]
WantedBy=graphical-session.target
